# A step whose flow leaves processes behind, three ways: a plain child, one
# in a session of its own (setsid) and an orphan (double fork). It writes
# their pids to $LEAK_PIDS, then touches $LEAK_PIDS.ready. $LEAK_MODE says
# what it does next: "exit" (return 0 at once), "wait" (wait for the plain
# child), "trap" (wait, and return 0 on SIGINT), "stubborn" (ignore SIGINT
# and SIGTERM, children included).

from bake import block, flow
from bake.step import Step


class LeakConfig:
    def __init__(self):
        self.flow = ""
        self.flow_options = {}


config.register("leak", LeakConfig())


class LeakStep(Step):
    name = "leak"
    default_flow = "leak_flow"
    source_files = []
    output_files = []


flow(name="leak_flow", run_cmd="run.sh", dir="leak_flow")

block(name="t", top="sample", rtl_files=["../rtl/sample.v"])
