# config.bake.default_libs: the libraries of every block that declares none.
# `plain` gets them, `own` replaces them, `more` adds to them.

from bake import load, block, lib

load("../flows")
config.impl.flow = "dummy_impl"

lib(name="cells", netlist_files=["../rtl/base.v"])
lib(name="other", netlist_files=["../rtl/leaf.v"])
config.bake.default_libs = ["cells"]

block(name="plain", top="sample", rtl_files=["../rtl/sample.v"])
block(name="own", top="sample", rtl_files=["../rtl/sample.v"], libs=["other"])
block(name="more", top="sample", rtl_files=["../rtl/sample.v"],
      libs=[*config.bake.default_libs, "other"])
