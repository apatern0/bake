# vrf_runtime_options: options for running the simulation only, from an env
# and a test, next to the build options (vrf_options).

from bake import load, block, env, test

load("../flows")
config.vrf.flow = "dummy_vrf"

block(name="dut", top="dut", rtl_files=["../rtl/dut.v"])

env(name="base_env", target="dut", default_sim="stub", vrf_runtime_options={"stub": ["+FROM_ENV=1"]})

test(name="plus_test", includes=["base_env"], vrf_files=["../rtl/tb1.v"],
     vrf_options={"stub": ["-build_opt"]}, vrf_runtime_options={"stub": ["+FROM_TEST=2"]})
test(name="_build", target="dut", vrf_files=["../rtl/tb2.v"], default_sim="stub")
test(name="bad_sim_test", target="dut", vrf_files=["../rtl/tb2.v"], default_sim="stub",
     vrf_runtime_options={"nosim": ["+X"]})
