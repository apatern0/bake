# Pass/fail criteria of the builtin vrf flow, run against a fake iverilog
# (fake_bin/, which the tests put on PATH): it writes an a.out that prints
# $FAKE_SIM_OUTPUT and exits 0, as Icarus does after $error.

from bake import block, env, test

block(name="dut", top="sample", rtl_files=["../rtl/sample.v"])
env(name="sim", vrf_files=["../rtl/sample_tb.v"], default_sim="icarus")
test(name="exit_code_only", target="dut", includes=["sim"])
test(name="fail_regex", target="dut", includes=["sim"], vrf_fail_regex=r"^ERROR\b")
test(name="pass_regex", target="dut", includes=["sim"], vrf_pass_regex="TEST PASSED")
