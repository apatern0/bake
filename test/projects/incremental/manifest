# A project for the up-to-date check: a `gen` step whose script can be made
# to fail after writing its output (CHECK_EXIT=1 in the environment), whose
# config reaches the flow as $BAKE_GEN_MODE, and which reads one of its
# sources through a symlink it lists itself (linked.v -> ../rtl/sample_tb.v;
# a manifest list would have resolved the link already).

from pathlib import Path

from bake import block, flow
from bake.step import Step


class GenConfig:
    def __init__(self):
        self.flow = ""
        self.flow_options = {}
        self.mode = "slow"


config.register("gen", GenConfig())


class GenStep(Step):
    name = "gen"
    default_flow = "gen_flow"

    @property
    def source_files(self):
        return list(self.data.rtl_files) + [str(Path(self.data.block_dir) / "linked.v")]

    @property
    def output_files(self):
        return [str(self.outputdir / "gen.txt")]

    def build_tpl_dict(self):
        tpl = super().build_tpl_dict()
        tpl["BAKE_GEN_MODE"] = self.config.mode
        return tpl


flow(name="gen_flow", run_cmd="run.sh", dir="gen_flow")

block(name="sample_target", top="sample", rtl_files=["../rtl/sample.v", "../rtl/base.v"])
