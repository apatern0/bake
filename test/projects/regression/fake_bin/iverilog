#!/bin/bash
# Stand-in for Icarus Verilog: records its command line in $FAKE_SIM_LOG and
# "compiles" to an a.out that records its own, with the seed bake gives the
# simulation ($RANDOM_SEED), and fails a simulation given +FAIL. A
# simulation takes $FAKE_SIM_SECONDS, when set.
echo "iverilog $*" >> "$FAKE_SIM_LOG"
cat > a.out <<'EOF'
#!/bin/bash
echo "a.out $RANDOM_SEED $*" >> "$FAKE_SIM_LOG"
[ -n "$FAKE_SIM_SECONDS" ] && sleep "$FAKE_SIM_SECONDS"
case " $* " in
  *" +FAIL "*) echo "fake simulation: failing as asked"; exit 1 ;;
esac
exit 0
EOF
chmod +x a.out
