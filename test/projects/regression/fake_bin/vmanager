#!/usr/bin/env python3
# Stand-in for Cadence vManager's client: takes the -execcmd of the vmanager
# flow (launch -wait -load {vsif}; csv_export -runs -out {csv} ...), copies
# the session file to $FAKE_VMANAGER_LOG and exports one row per run the
# session file declares, with status $FAKE_VMANAGER_STATUS (default passed).
import os
import re
import shutil
import sys

tcl = sys.argv[sys.argv.index("-execcmd") + 1]
vsif, runs_csv = re.findall(r"\{([^}]*)\}", tcl)[:2]
shutil.copy(vsif, os.environ["FAKE_VMANAGER_LOG"])
text = open(vsif, encoding="utf-8").read()
status = os.environ.get("FAKE_VMANAGER_STATUS", "passed")
rows = []
for group, body in re.findall(r"^group (\w+) \{(.*?)^\};", text, re.S | re.M):
    for name, count in re.findall(r"test (\w+) \{.*?count: (\d+);", body, re.S):
        rows += [f"/{group}/{name}"] * int(count)
with open(runs_csv, "w", encoding="utf-8") as f:
    f.write("Index,Name,Status,Duration (sec.),Top Files\n")
    for i, name in enumerate(rows, start=1):
        f.write(f"{i},{name},{status},1,\n")
