# How the regression step runs a regression(), against a fake xrun and a fake
# vmanager (fake_bin/, which the tests put on PATH). The fake xrun appends
# each command line to $FAKE_XRUN_LOG and fails a simulation given +FAIL;
# the fake vmanager is described in its own file. With BAKE_TEST_VMANAGER
# set, the regressions run through the vmanager flow (with no server if it
# is "noserver").

import os

from bake import block, regression, test

block(name="dut", top="sample", rtl_files=["../rtl/sample.v"])
test(name="good", target="dut", vrf_files=["../rtl/sample_tb.v"], default_sim="xcelium")
test(name="bad", target="dut", vrf_files=["../rtl/sample_tb.v"], default_sim="xcelium",
     vrf_runtime_options={"xcelium": ["+FAIL"]})

regression(name="smoke", target="dut", tests={"good": 2})
regression(name="full", target="dut", tests={"bad": [7]}, includes=["smoke"],
           options=["vrf.runtime_options=+NIGHTLY"])

if os.environ.get("BAKE_TEST_VMANAGER"):
    config.regression.flow = "vmanager"
    if os.environ["BAKE_TEST_VMANAGER"] != "noserver":
        config.regression.flow_options["server"] = "localhost:8080"
