# Source templates (*.tpl): a block's RTL and a bench rendered before the flow
# gets them. The bench reaches the pixels of a core through the names a
# netlist gives them when NETLIST is defined, and through the generate scopes
# of the RTL otherwise.

from bake import load, block, test

load("../flows")
config.impl.flow = "dummy_impl"
config.vrf.flow = "dummy_vrf"

block(name="core", top="core", rtl_files=["./core.v.tpl"])

test(name="rtl_test", target="core", vrf_files=["./tb.sv.tpl"], default_sim="stub")
test(name="rtl_test_again", target="core", vrf_files=["./tb.sv.tpl"], default_sim="stub")
test(name="netlist_test", target="core", vrf_files=["./tb.sv.tpl"], vrf_defines=["NETLIST"], default_sim="stub")

# Templates that cannot be rendered: a variable nobody defines, a statement
# left open.
test(name="undefined_test", target="core", vrf_files=["./undefined.sv.tpl"], default_sim="stub")
test(name="syntax_test", target="core", vrf_files=["./syntax.sv.tpl"], default_sim="stub")
