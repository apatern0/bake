# Cell roles of the libraries a block uses (lib(cells=...)), handed to its
# flows: `cells` and `more` are standard-cell libraries, `pads` an I/O pad
# library. `top` uses all three: a role's cells come from every library, in
# the order the block names them, each cell once.

from bake import load, block, lib

load("../flows")
config.impl.flow = "dummy_impl"

lib(name="cells", liberty_files={"TC": "../rtl/base.v"}, cells={
    "site": "core",
    "filler": ["FILL4", "FILL1"],
    "tie_hi": ("TIEH", "Z"),
    "tie_lo": [("TIEL", "ZN")],
    "clock_buffer": ["CKBUF2", "CKBUF1"],
})
lib(name="more", liberty_files={"TC": "../rtl/leaf.v"}, cells={
    "filler": ["FILL1", "FILL8"],
    "clock_gate": "ICG1",
})
lib(name="pads", cells={
    "io_site": "pad",
    "io_corner_site": "corner",
    "io_corner": "CORNER",
    "io_filler": ["PFILL10", "PFILL1"],
    "io_ring_break": "BREAK",
    "io_power": "PVDD",
    "io_ground": "PVSS",
})

block(name="top", top="sample", rtl_files=["../rtl/sample.v"], libs=["cells", "more", "pads"])
block(name="plain", top="sample", rtl_files=["../rtl/sample.v"])
