# Liberty corner consistency for the impl step. The flow has corners TT and
# SS; `full` has Liberty for both, `tt_only` for TT alone. A block using
# both libraries is rejected: SS is in use but tt_only cannot serve it. A
# block using tt_only alone is fine: SS is simply not used.

from bake import load, block, flow, lib

load("../flows")

flow(name="two_corners", corners=[("TT", "Typical"), ("SS", "Slow")],
     run_cmd="run.sh", dir="../flows/impl")
config.impl.flow = "two_corners"

lib(name="full", liberty_files={"TT": ["../rtl/base.v"], "SS": ["../rtl/leaf.v"]})
lib(name="tt_only", liberty_files={"TT": "../rtl/base.v"})

block(name="ok", top="sample", rtl_files=["../rtl/sample.v"], libs=["full"])
block(name="partial", top="sample", rtl_files=["../rtl/sample.v"], libs=["tt_only"])
block(name="broken", top="sample", rtl_files=["../rtl/sample.v"], libs=["full", "tt_only"])
