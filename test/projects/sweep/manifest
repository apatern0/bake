# A sweep() of one block's impl over the variants of a project section; the
# summary_impl stand-in flow writes each run's summary.json, and fails the
# variant that sets proj.fail.

from bake import block, load, sweep


class ProjConfig(config.FixedSchemaAttributes):
    def __init__(self):
        self.width = config.option(8, "Data width in bits", choices=[8, 16, 32])
        self.fail = config.option(False, "Make the flow fail")
        self.sleep = config.option(0, "Seconds the flow sleeps first")


config.register("proj", ProjConfig(), templates=True)

load("../flows")
config.impl.flow = "summary_impl"

block(name="dut", top="dut", rtl_files=["../rtl/dut.v"])

sweep(name="widths", desc="Which data width fits?", target="dut", recipe="impl",
      options=["proj.fail=false"],
      variants={"w8": ["proj.width=8"], "w16": "proj.width=16",
                "w32": ["proj.width=32", "proj.fail=true"]})
