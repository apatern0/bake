# A sweep() of one block's impl over variants of the project's options; the
# summary_impl stand-in flow writes each run's summary.json, and fails the
# variant that sets fail.

from bake import block, load, option, project, sweep

project(
    "sweep",
    width=option(8, "Data width in bits", choices=[8, 16, 32]),
    fail=option(False, "Make the flow fail"),
    sleep=option(0, "Seconds the flow sleeps first"),
)

load("../flows")
config.impl.flow = "summary_impl"

block(name="dut", top="dut", rtl_files=["../rtl/dut.v"])

sweep(name="widths", desc="Which data width fits?", target="dut", recipe="impl",
      options=["fail=false"],
      variants={"w8": ["width=8"], "w16": "width=16",
                "w32": ["width=32", "fail=true"]})
