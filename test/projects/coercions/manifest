# Argument forms the specs accept besides a list of strings: a single
# string, Path objects, a single file per corner; and a layout_info entry
# that does not exist, which is a warning.

from pathlib import Path
from bake import block, lib, env, test

rtl = Path(__file__).parent / ".." / "rtl"

lib(name="l", liberty_files={"TT": "../rtl/base.v"}, layout_info="../rtl/leaf.v missing.lef")
block(name="x", top="sample", rtl_files=rtl / "sample.v", libs="l", sdc_files="../rtl/base.v")
env(name="e", vrf_files="../rtl/sample_tb.v", vrf_defines="X")
test(name="t", target="x", includes="e")
