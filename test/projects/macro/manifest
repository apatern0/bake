# A macro(): an implemented block, declared by its netlist and abstracts. It
# is lib data from the start, so an RTL block including it gets it as a
# macro, vrf simulates its netlist, and tmr (which takes RTL) refuses it.

from bake import load, block, macro, test

load("../flows")
config.impl.flow = "dummy_impl"
config.vrf.flow = "dummy_vrf"

macro(
    name="macro",
    top="block",
    netlist_files=["../rtl/block.v"],
    layout_info="../rtl/block.v",           # stands in for a LEF
    liberty_files={"TC": "../rtl/block.v"}, # stands in for a Liberty file
)
test(name="macro_test", target="macro", vrf_files=["../rtl/top_tb.v"], default_sim="stub")

block(name="top", top="top", includes=["macro"], rtl_files=["../rtl/top.v"])
test(name="top_test", target="top", vrf_files=["../rtl/top_tb.v"], default_sim="stub")
