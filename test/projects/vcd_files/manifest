# Switching-activity files on a block: as a plain list (the "default"
# corner) and as a corner dict.

from bake import load, block

load("../flows")
config.impl.flow = "dummy_impl"

block(name="plain", top="sample", rtl_files=["../rtl/sample.v"],
      vcd_files=["../rtl/sample.v"])
block(name="corners", top="sample", rtl_files=["../rtl/sample.v"],
      vcd_files={"tt": ["../rtl/sample.v"], "ss": "../rtl/base.v"},
      saif_files="../rtl/base.v")
