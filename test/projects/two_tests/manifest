# A block with two tests: vrf needs -t to pick one.

from bake import load, block, test

load("../flows")
config.vrf.flow = "dummy_vrf"

block(name="dut", top="dut", rtl_files=["../rtl/dut.v"])

test(name="test_a", target="dut", vrf_files=["../rtl/tb1.v"], default_sim="stub")
test(name="test_b", target="dut", vrf_files=["../rtl/tb2.v"], default_sim="stub")
