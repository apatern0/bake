# impl's inputs include the files of the libraries and macros it reads: the
# Liberty and layout files of a lib() and of a macro(), where a layout may be
# a directory (a library of its own, not a file to compare).

from bake import block, flow, lib, macro

flow(name="phys_impl", corners=[("TC", "Typical Case")], run_cmd="run.sh", dir="phys")
config.impl.flow = "phys_impl"

lib(name="cells", liberty_files={"TC": "../rtl/base.v"}, layout_info="../rtl")
macro(name="sub", top="block", netlist_files=["../rtl/block.v"],
      liberty_files={"TC": "../rtl/leaf.v"}, layout_info="../rtl/top.v")

block(name="top", top="top", rtl_files=["../rtl/top.v"], libs=["cells"], includes=["sub"])
