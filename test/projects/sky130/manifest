# The shared counter design on the reference sky130 PDK manifest, with a clock
# constraint and its testbench: what the impl and impl-vrf recipes are
# verified on when yosys, openroad and iverilog are installed. Relative paths
# assume the repository layout (../../../example).

from bake import load, block, test

load("../../../example/pdk/sky130")

block(
    name="counter",
    top="counter",
    rtl_files=["../../../example/counter/rtl/counter.v"],
    sdc_files=["counter.sdc"],
    libs=["sky130_fd_sc_hd"],
)

test(
    name="counter_test",
    target="counter",
    vrf_files=[
        "../../../example/counter/vrf/verilog/counterWrapper.v",
        "../../../example/counter/vrf/verilog/counter_verilog_test.v",
    ],
    default_sim="icarus",
)
