"""A do-nothing step: it declares no sources and no outputs, so it runs
every time, and its flow only prints a line. The recipe tests combine it
with the real steps. For the template of a step of your own, see
example/06_custom_step and docs/custom_steps.md.
"""


from bake.step import Step
from bake.manifest import FlowSpec


class DummyConfig(config.FixedSchemaAttributes):
    def __init__(self):
        self.tpl_dict     = config.TemplateDictionary()
        self.flow         = ""
        self.flow_options = {}


config.register('dummy', DummyConfig())


class DummyStep(Step):
    name = "dummy"
    default_flow = "dummy_flow"

    @property
    def output_files(self):
        return []

    @property
    def source_files(self):
        return []


FlowSpec(
    name="dummy_flow",
    run_cmd="run.sh",
)
