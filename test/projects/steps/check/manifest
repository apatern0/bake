# A custom `check` step laid out like a built-in one: this manifest next to
# flow/. Its script records what the base class hands every step ($BAKE_BLOCK,
# $BAKE_TOP) and the is_last flag, which the tests read back.

import os
from bake.step import Step
from bake.manifest import FlowSpec


class CheckConfig:
    def __init__(self):
        self.flow = ""
        self.flow_options = {}


config.register('check', CheckConfig())


class CheckStep(Step):
    name = "check"
    default_flow = "check_flow"

    @property
    def source_files(self):
        return list(self.data.rtl_files)

    @property
    def output_files(self):
        return [os.path.join(self.outputdir, "check_result.txt")]

    def build_tpl_dict(self):
        tpl = super().build_tpl_dict()
        tpl["BAKE_CHECK_IS_LAST"] = str(self.data.is_last)
        return tpl


FlowSpec(name="check_flow", run_cmd="run.sh")
