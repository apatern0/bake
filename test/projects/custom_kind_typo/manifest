# Rejected: a misspelled argument to a spec a manifest defines is reported
# like one to block(), under the spec's manifest function name.

from typing import ClassVar

from bake.manifest import DesignSpec
from bake.step import StepData


class NoteSpec(DesignSpec):
    manifest_function: ClassVar[str] = "note"
    text: str = ""

    @property
    def data_type(self):
        return StepData

    def to_data(self):
        return StepData(block=self.name)


NoteSpec(name="n", txt="hello")
