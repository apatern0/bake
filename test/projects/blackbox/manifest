# A macro() that comes as a LEF only: blackbox writes its netlist and
# Liberty, and a block that includes it after blackbox gets them as
# abstracts (impl) and netlist (vrf). The timing of its pins leaves busy
# untimed, which blackbox reports.

from bake import load, block, macro

load("../flows")
config.impl.flow = "dummy_impl"

macro(name="adc", top="adc", layout_info="adc.lef")
block(name="top", top="top", includes={"adc": "blackbox"}, rtl_files=["../rtl/top.v"])

config.blackbox.corners = ["TC"]
config.blackbox.pins["adc"] = {
    "clk":   {"clock": True, "capacitance": 0.004},
    "start": {"related_pin": "clk", "setup": 0.3, "hold": 0.1, "capacitance": 0.002},
    "dout":  {"related_pin": "clk", "delay": 1.5, "transition": 0.2},
}
