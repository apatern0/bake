# A step defined in the project manifest itself, with its flow next to it.

from bake import load, block, flow
from bake.step import Step

load("../flows")


class NopConfig:
    def __init__(self):
        self.flow = ""
        self.flow_options = {}


config.register("nop", NopConfig())


class NopStep(Step):
    name = "nop"
    default_flow = "nop_flow"
    source_files = []

    @property
    def output_files(self):
        return [str(self.outputdir / "nop.txt")]


flow(name="nop_flow", run_cmd="run.sh", dir="nop_flow")

block(name="sample_target", top="sample", rtl_files=["../rtl/sample.v"])
