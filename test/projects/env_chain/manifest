# Three-level environment inheritance: env -> env -> test.

from bake import load, block, env, test

load("../flows")
config.vrf.flow = "dummy_vrf"

block(name="dut", top="dut", rtl_files=["../rtl/dut.v"])

env(name="base_env", target="dut", vrf_files=["../rtl/base.v"])
env(name="mid_env", target="dut", includes=["base_env"], vrf_files=["../rtl/mid.v"])

test(name="leaf_test", target="dut", includes=["mid_env"], vrf_files=["../rtl/leaf.v"], default_sim="stub")
