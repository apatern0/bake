# The portscheck step on two macros of the same LEF (../blackbox/adc.lef):
# adc, whose Verilog and Liberty blackbox writes, so that blackbox-portscheck
# agrees; adc_bad, whose hand-written netlist and LVS netlist disagree with
# the LEF (busy missing, start an output, VSS missing from the LVS
# netlist, which is waived).

from bake import load, macro

load("../flows")

macro(name="adc", top="adc", layout_info="../blackbox/adc.lef")
macro(name="adc_bad", top="adc", layout_info="../blackbox/adc.lef",
      netlist_files=["adc_bad.v"], lvs_files=["adc_bad.cdl"])

config.blackbox.corners = ["TC"]
config.portscheck.waive["adc_bad"] = {"VSS": "the LVS netlist takes VSS from the substrate"}
