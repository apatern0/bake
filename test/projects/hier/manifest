# Hierarchical designs: a block including another as RTL (list and dict
# forms), after its impl recipe (a dependency, with a test so vrf can run on
# it), and after tmr-impl.

from bake import load, block, test

load("../flows")
config.impl.flow = "dummy_impl"
config.vrf.flow = "dummy_vrf"

block(name="block", top="block", rtl_files=["../rtl/block.v"])

block(name="top", top="top", includes=["block"], rtl_files=["../rtl/top.v"])
block(name="top_dict", top="top", includes={"block": "rtl"}, rtl_files=["../rtl/top.v"])

block(name="top2", top="top", includes={"block": "impl"}, rtl_files=["../rtl/top.v"])
test(name="top2_test", target="top2", vrf_files=["../rtl/top_tb.v"], default_sim="stub")

block(name="top3", top="top", includes={"block": "tmr-impl"}, rtl_files=["../rtl/top.v"])
