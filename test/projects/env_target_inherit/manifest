# A test that names no target inherits it from the environments it includes.

from bake import load, block, env, test

load("../flows")
config.vrf.flow = "dummy_vrf"

block(name="dut", top="sample", rtl_files=["../rtl/sample.v"])
env(name="base", target="dut", vrf_files=["../rtl/sample_tb.v"], default_sim="stub")
env(name="mid", includes=["base"])
test(name="leaf_test", includes=["mid"])
