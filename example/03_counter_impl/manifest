# 03 - Synthesise and place-and-route a block: the single-step recipe `impl`.
#
# The built-in impl step targets the open-source SkyWater sky130 PDK with
# Yosys and OpenROAD, so nothing needs to be configured: the sky130 cell
# libraries are registered automatically once the PDK submodule is present.
#
#   bake -l                # list the sky130 libraries bake found
#   bake counter impl      # synthesis + P&R; outputs in work/counter/impl/output
#   bake counter impl -p   # only populate flow/counter/impl with the scripts
#
# The scripts in flow/counter/impl are yours to edit after the first run.
#
# Needs: yosys, openroad, and the skywater-pdk submodule
#   (git submodule update --init bake/builtin/impl/skywater-pdk).

from bake import block

block(
    name="counter",
    top="counter",
    rtl_files=["../counter/rtl/counter.v"],
    # libs=["sky130_fd_sc_hd"] is the default; pick another sky130 library here.
)
