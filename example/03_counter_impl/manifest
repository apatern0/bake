# 03 - Synthesise and place-and-route a block: the single-step recipe `impl`.
#
# The built-in impl step runs Yosys and OpenROAD; it needs standard-cell
# libraries, which come from a PDK manifest. bake ships none: this example
# loads the reference manifest for the open-source SkyWater sky130 PDK from
# example/pdk/sky130, which registers every library it finds under PDK_ROOT
# and makes sky130_fd_sc_hd the default. Copy that manifest to adapt bake to
# your own PDK.
#
#   bake -l                # list the libraries the PDK manifest registered
#   bake counter impl      # synthesis + P&R; outputs in work/counter/impl/output
#   bake counter impl-vrf  # then simulate the netlist with the SDF annotated
#   bake counter impl -p   # only populate flow/counter/impl with the scripts
#
# counter.sdc defines the clock, which is what clock tree synthesis works on.
# The scripts in flow/counter/impl are yours to edit after the first run.
#
# Needs: yosys, openroad (icarus for impl-vrf), and PDK_ROOT set to a sky130
#   open_pdks build (PDK_ROOT=$HOME/.ciel test/pdk/fetch_sky130.sh && export
#   PDK_ROOT=$HOME/.ciel).

from bake import load, block, test

load("../pdk/sky130")

block(
    name="counter",
    top="counter",
    rtl_files=["../counter/rtl/counter.v"],
    sdc_files=["counter.sdc"],  # defines the clock, so P&R synthesises a clock tree
    libs=["sky130_fd_sc_hd"],   # registered by ../pdk/sky130; any sky130_fd_sc_* works
)

# The same testbench as example 01, run on the implemented netlist with the
# sky130 cell models: `bake counter impl-vrf`.
test(
    name="counter_test",
    target="counter",
    vrf_files=[
        "../counter/vrf/verilog/counterWrapper.v",
        "../counter/vrf/verilog/counter_verilog_test.v",
    ],
    default_sim="icarus",
)
