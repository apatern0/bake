# 07 - Manifests are Python: generate tests in a loop.
#
# One test bench, parametrised through a `WIDTH define, becomes four tests.
# Anything you can compute in Python -- loops, environment variables, file
# globbing -- can drive what a manifest declares.
#
#   bake                                # lists counter_w4 .. counter_w16
#   bake counter vrf -t counter_w8
#   for w in 4 8 12 16; do bake counter vrf -t counter_w$w; done
#
# Needs: Icarus Verilog.

from bake import block, env, test

block(
    name="counter",
    top="counter",
    rtl_files=["../counter/rtl/counter.v"],
)

env(
    name="width_env",
    target="counter",
    vrf_top="counter_width_tb",
    vrf_files=["vrf/counter_width_tb.v"],
    default_sim="icarus",
)

for width in (4, 8, 12, 16):
    test(
        name=f"counter_w{width}",
        includes=["width_env"],
        vrf_defines=[f"WIDTH={width}"],
    )
