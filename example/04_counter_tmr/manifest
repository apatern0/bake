# 04 - Triplicate a block, then simulate the triplicated RTL: `tmr` and `tmr-vrf`.
#
# The tmr step runs tmrg on the block's RTL and hands the triplicated files
# (counterTMR.v, top module counterTMR, define TMR) to whatever step follows.
# The wrapper test bench picks the right DUT via `ifdef TMR, so the same
# test runs before and after triplication.
#
#   bake counter vrf        # plain RTL
#   bake counter tmr        # triplicate only
#   bake counter tmr-vrf    # triplicate, then simulate the result
#
# Needs: tmrg (https://github.com/rlf-arlut/tmrg), Icarus Verilog.

from bake import block, test

block(
    name="counter",
    top="counter",
    rtl_files=["../counter/rtl/counter.v"],
)

test(
    name="counter_test",
    target="counter",
    vrf_files=[
        "../counter/vrf/verilog/counterWrapper.v",
        "../counter/vrf/verilog/counter_verilog_test.v",
    ],
    default_sim="icarus",
)
