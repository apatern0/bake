# 01 - Simulate a block with a plain Verilog test bench.
#
# Shows the two declarations every project starts with: a block() bundling
# the RTL, and a test() bundling the test bench that exercises it.
#
#   bake counter vrf
#
# Needs: Icarus Verilog (iverilog/vvp).

from bake import block, test

block(
    name="counter",
    top="counter",
    rtl_files=["../counter/rtl/counter.v"],
)

test(
    name="counter_test",
    target="counter",
    vrf_files=[
        "../counter/vrf/verilog/counterWrapper.v",
        "../counter/vrf/verilog/counter_verilog_test.v",
    ],
    default_sim="icarus",
)
