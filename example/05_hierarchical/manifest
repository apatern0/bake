# 05 - Hierarchical designs: one block including another.
#
# `includes` lets a block depend on another block in two ways:
#
#   includes=["adder"]             pull in the adder's RTL files ("rtl" include)
#   includes={"adder": "impl"}     use the *implemented* adder -- its netlist and
#                                  timing library from `bake adder impl` -- as a
#                                  hard macro inside this block
#
# The second form is validated when the manifest loads: the adder's impl output
# must already exist. skip_on_include_errors=True lets the manifest load anyway
# and just skips that block until you have run `bake adder impl`.
#
#   bake accumulator vrf               # RTL simulation, adder pulled in as RTL
#   bake adder impl                    # implement the sub-block first ...
#   bake accumulator_hard impl         # ... then the top with the adder as a macro
#   bake accumulator_hard impl-vrf     # gate-level simulation of the result
#
# Needs: Icarus Verilog for vrf; yosys, openroad and PDK_ROOT pointing at sky130 for impl
#   (libraries come from the reference PDK manifest in ../pdk/sky130).

import os
from bake import load, block, test

# The vrf recipes need no PDK; only load the sky130 libraries when one is
# available so that `bake accumulator vrf` works on a machine without it.
if os.environ.get("PDK_ROOT"):
    load("../pdk/sky130")

block(
    name="adder",
    top="adder",
    rtl_files=["rtl/adder.v"],
)

block(
    name="accumulator",
    top="accumulator",
    rtl_files=["rtl/accumulator.v"],
    includes=["adder"],
)

block(
    name="accumulator_hard",
    top="accumulator",
    rtl_files=["rtl/accumulator.v"],
    includes={"adder": "impl"},
    skip_on_include_errors=True,
)

test(
    name="accumulator_test",
    target="accumulator",
    vrf_files=["vrf/accumulator_tb.v"],
    default_sim="icarus",
)

test(
    name="accumulator_test",
    target="accumulator_hard",
    vrf_files=["vrf/accumulator_tb.v"],
    default_sim="icarus",
)
