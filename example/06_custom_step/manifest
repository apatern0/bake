# 06 - A custom step, and recipes that use it.
#
# steps/lint.py defines a `lint` step (a Step subclass with its own config
# section) and flows/lint/ holds the script it runs. add_steps_dir() loads
# every .py file in the directory; the step then appears next to the built-in
# ones and can be used in any recipe.
#
#   bake                                  # lint is listed with vrf, impl, tmr, dummy
#   bake counter lint                     # single-step recipe
#   bake counter lint-vrf                 # lint, then simulate
#   bake counter lint -o lint.options=-Wno-DECLFILENAME
#
# Needs: Verilator for lint, Icarus Verilog for vrf.

from bake import block, test, add_steps_dir

add_steps_dir("steps/")

block(
    name="counter",
    top="counter",
    rtl_files=["../counter/rtl/counter.v"],
)

test(
    name="counter_test",
    target="counter",
    vrf_files=[
        "../counter/vrf/verilog/counterWrapper.v",
        "../counter/vrf/verilog/counter_verilog_test.v",
    ],
    default_sim="icarus",
)
