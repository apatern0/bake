"""Dummy step — template for user-defined steps.

Copy this file, rename the class and set the class attributes to match your
flow.  Implement run(), check_post(), and clean().
"""


from bake.step import Step
from bake.manifest import FlowSpec


class DummyConfig:
    def __init__(self):
        self.flow         = ""
        self.flow_options = {}


config.register('dummy', DummyConfig())


class DummyStep(Step):
    name = "dummy"
    default_flow = "dummy_flow"

    @property
    def output_files(self):
        return []

    @property
    def source_files(self):
        return []


FlowSpec(
    name="dummy_flow",
    run_cmd="run.sh",
)
