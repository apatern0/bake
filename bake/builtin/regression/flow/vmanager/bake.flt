# vm_scan.pl filters for the runs of a regression (bake_run.py): the run's
# console log carries bake's messages and the vrf flow's. A project adds its
# own filter files with the flow option scan_filters.
#
# syntax:
#	add_top_filter(attr-name, match-regexp, replacement)
#	add_filter(attr-name, priority, match-regexp, replacement, else-replacement)
#	failure(ref, tool, kind, severity, description)

# The seed bake drew for a run that vManager started with sv_seed "random",
# recorded as the run's sv_seed, so that a rerun from vManager repeats it
# (the filter is named apart from the attribute, which project filters may
# record as well)
add_top_filter ("bake_sv_seed", '\[runsim\] INFO\s+Simulation seed: (\d+)', 'sv_seed: $1;');

# What failed the test, as the vrf flow says (pass/fail criteria, UVM summary, ...)
add_filter ("bake_vrf_error", 3, '\[runsim\] ERROR\s+(.*)',
	failure (1, "bake", "vrf", "error", '$1'));

# bake's verdict on the run
add_filter ("bake_error", 2, '\[bake\] ERROR\s+(.*)',
	failure (1, "bake", "error", "error", '$1'));
