direction: right

files {
    fifo_dp: fifo_dp.v {shape: document}
    gray_counter: gray_counter.v {shape: document}
    arbiter: arbiter.v {shape: document}
    my_top: my_top.v {shape: document}
}

fifo_dp: block\nfifo_dp {shape: hexagon}
arbiter: block\narbiter {shape: hexagon}
concentrator: block\nconcentrator {shape: hexagon}

files.fifo_dp -> fifo_dp
files.gray_counter -> fifo_dp
files.arbiter -> arbiter
files.my_top -> concentrator

fifo_dp -> concentrator
arbiter -> concentrator

