direction: right

files: {
    rtl: counter.v {shape: document}
    wrapper: counterWrapper.v {shape: document}
    tb: counter_verilog_test.v {shape: document}
}

block: block\ncounter {
    style.font-size: 20
    shape: hexagon
    tooltip: This block bundles our RTL files, here it's only 'counter.v'.
}

files.rtl -> block

test: test\ncounter_test {
    style.font-size: 20
    shape: oval
    tooltip: This test bundles our verification files and is linked to one block.
}

files.wrapper -> test
files.tb -> test

block -> test
