direction: right

files {
    a: a.v {shape: document}
    b: b.v {shape: document}
    c: c.v {shape: document}
    d: d.v {shape: document}
}

a: block\na {shape: hexagon}
b: block\nb {shape: hexagon}
c: block\nc {shape: hexagon}
abc: block\nabc\ntop=c {shape: hexagon}
abcd: block\nabcd\ntop=d {shape: hexagon}

files.a -> a
files.b -> b
files.c -> c

a -> abc
b -> abc
c -> abc

a -> abcd
b -> abcd
c -> abcd

files.d -> abcd
